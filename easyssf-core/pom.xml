<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.easyssf</groupId>
        <artifactId>easyssf-parent</artifactId>
        <version>0.6.0-SNAPSHOT</version>
    </parent>
    <artifactId>easyssf-core</artifactId>
    <name>easyssf-core</name>
    <description>The data structures of the Shared Signals Framework shared by receivers and transmitters</description>

    <properties>
        <automatic.module.name>org.easyssf.core</automatic.module.name>
        <!-- the test packages, opened to JUnit when the IDE runs the tests (profile "ide" of the root POM) -->
        <ide.test.add-opens>
            --add-opens org.easyssf.core/org.easyssf.core=org.junit.platform.commons
            --add-opens org.easyssf.core/org.easyssf.core.caep=org.junit.platform.commons
            --add-opens org.easyssf.core/org.easyssf.core.event=org.junit.platform.commons
            --add-opens org.easyssf.core/org.easyssf.core.metadata=org.junit.platform.commons
            --add-opens org.easyssf.core/org.easyssf.core.risc=org.junit.platform.commons
            --add-opens org.easyssf.core/org.easyssf.core.scim=org.junit.platform.commons
        </ide.test.add-opens>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
