<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.easyssf</groupId>
        <artifactId>easyssf-parent</artifactId>
        <version>0.3.0</version>
    </parent>
    <artifactId>easyssf-receiver-spring-boot-starter</artifactId>
    <name>easyssf-receiver-spring-boot-starter</name>
    <description>Starter that turns a Spring Boot application into a Shared Signals Framework receiver</description>

    <properties>
        <automatic.module.name>org.easyssf.receiver.spring.boot.starter</automatic.module.name>
    </properties>


    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.easyssf</groupId>
            <artifactId>easyssf-receiver-spring-boot-autoconfigure</artifactId>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <!-- Maven Central wants a javadoc jar for every jar, but javadoc refuses a module whose
                 only source is a package-info. The javadoc jar of the starter is built from
                 src/main/javadoc instead. -->
            <id>release</id>
            <properties>
                <maven.javadoc.skip>true</maven.javadoc.skip>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>javadoc-jar</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                                <configuration>
                                    <classifier>javadoc</classifier>
                                    <classesDirectory>${project.basedir}/src/main/javadoc</classesDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
