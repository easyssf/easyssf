<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.easyssf</groupId>
        <artifactId>easyssf-receiver-spring-boot-examples</artifactId>
        <version>0.2.0-SNAPSHOT</version>
    </parent>
    <artifactId>example-scim-provisioning</artifactId>
    <name>example-scim-provisioning</name>
    <description>Mirrors the users of a SCIM service provider into a local directory from its SCIM Events (RFC 9967)</description>

    <properties>
        <automatic.module.name>org.easyssf.examples.scim</automatic.module.name>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.easyssf</groupId>
            <artifactId>easyssf-receiver-spring-boot-starter</artifactId>
        </dependency>
        <!-- Keycloak does not emit SCIM Events, so the example brings the transmitter along: the
             in-process TestTransmitter of easyssf-test, see ExampleScimProvisioningApplication -->
        <dependency>
            <groupId>org.easyssf</groupId>
            <artifactId>easyssf-test</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
